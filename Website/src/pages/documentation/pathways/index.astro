---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DocumentationCard from "../../../components/DocumentationCard.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="Pathways API | Documentation" description="Module index for the generated Pathways API reference.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">API documentation</p>
      <h1>Pathways module</h1>
      <p class="lede">Reference documentation generated from the public declarations and DocC comments in the Swift package.</p>
    </div>
  </section>
  <section class="section">
    <div class="container card-grid">
      <DocumentationCard title="Open the API reference" description="Browse protocols, types, methods, properties, and error cases generated by Swift DocC." href={`${base}documentation/pathways/documentation/pathways/`} />
      <DocumentationCard title="Read the guide first" description="Start with route patterns, supported values, and handler behavior before using the symbol reference." href={`${base}documentation/`} />
    </div>
  </section>
</BaseLayout>
